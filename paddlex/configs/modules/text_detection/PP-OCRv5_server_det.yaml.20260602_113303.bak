  device: gpu:0
  output: D:/dl/projects/Git/PaddleX/output/det/20260602/res_1
CheckDataset:
  convert:
    enable: false
    src_dataset_type: null
  split:
    enable: false
    train_percent: null
    val_percent: null
Train:
  epochs_iters: 50
